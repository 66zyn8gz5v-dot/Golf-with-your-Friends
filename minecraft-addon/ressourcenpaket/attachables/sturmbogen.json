        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/sturmbogen",
        "bow_pulling_0": "textures/items/sturmbogen_pulling_0",
        "bow_pulling_1": "textures/items/sturmbogen_pulling_1",
        "bow_pulling_2": "textures/items/sturmbogen_pulling_2",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.fynn_bogen_0",
