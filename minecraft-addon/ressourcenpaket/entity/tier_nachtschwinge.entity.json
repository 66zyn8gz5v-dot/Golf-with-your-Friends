{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:nachtschwinge",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "nacht": "textures/entity/tiere/nachtschwinge_nacht",
        "sturm": "textures/entity/tiere/nachtschwinge_sturm",
        "blut": "textures/entity/tiere/nachtschwinge_blut"
      },
      "geometry": {
        "default": "geometry.fynn.nachtschwinge"
      },
      "animations": {
        "flug": "animation.fynn.nachtschwinge.flug",
        "schweben": "animation.fynn.nachtschwinge.schweben",
        "stand": "animation.fynn.nachtschwinge.stand",
        "gehen": "animation.fynn.nachtschwinge.gehen",
        "platz": "animation.fynn.nachtschwinge.platz",
        "schlafen": "animation.fynn.nachtschwinge.schlafen",
        "niederliegen": "animation.fynn.nachtschwinge.niederliegen",
        "luftholen": "animation.fynn.nachtschwinge.luftholen",
        "schattenatem": "animation.fynn.nachtschwinge.schattenatem",
        "drachenbruellen": "animation.fynn.nachtschwinge.drachenbruellen",
        "sturzflug": "animation.fynn.nachtschwinge.sturzflug",
        "drachenblick": "animation.fynn.nachtschwinge.drachenblick",
        "drachenbiss": "animation.fynn.nachtschwinge.drachenbiss",
        "uralt": "animation.fynn.nachtschwinge.uralt"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);",
          "variable.fynn_t = query.life_time + variable.fynn_zufall * 0.05;",
          "variable.fynn_ruhig = (1.0 - math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0)) * (1.0 - query.property('fynn:feuer')) * (1.0 - query.property('fynn:fliegt')) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt'))) * (1.0 - (query.property('fynn:wartet') * (1.0 - query.has_rider)));",
          "variable.fynn_bz = math.mod(variable.fynn_t, 17.0);",
          "variable.fynn_bruell = variable.fynn_bz < 2.4 ? math.clamp(math.sin(variable.fynn_bz / 2.4 * 180.0) * 2.2, 0.0, 1.0) * variable.fynn_ruhig : 0.0;",
          "variable.fynn_sz = math.mod(variable.fynn_t + 6.0, 31.0);",
          "variable.fynn_az = query.property('fynn:feuer') ? variable.fynn_az + query.delta_time : 0.0;",
          "variable.fynn_holen = query.property('fynn:feuer') * math.clamp(variable.fynn_az / 0.25, 0.0, 1.0) * (1.0 - math.clamp((variable.fynn_az - 1.0) / 0.12, 0.0, 1.0));",
          "variable.fynn_speit = query.property('fynn:feuer') * math.clamp((variable.fynn_az - 1.0) / 0.12, 0.0, 1.0);",
          "variable.fynn_ruck = variable.fynn_speit * math.max(0.0, 1.0 - (variable.fynn_az - 1.0) / 0.4);",
          "variable.fynn_offen_l = math.max(math.max(variable.fynn_bruell, math.clamp(math.sin(math.clamp((variable.fynn_sz - 0.0) / 3.2, 0.0, 1.0) * 180.0) * 1.6, 0.0, 1.0) * variable.fynn_ruhig), variable.fynn_speit * 0.6);",
          "variable.fynn_offen_r = math.max(math.max(variable.fynn_bruell, math.clamp(math.sin(math.clamp((variable.fynn_sz - 3.8) / 3.2, 0.0, 1.0) * 180.0) * 1.6, 0.0, 1.0) * variable.fynn_ruhig), variable.fynn_speit * 0.6);"
        ],
        "animate": [
          {
            "flug": "query.property('fynn:fliegt') * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "schweben": "query.property('fynn:fliegt') * query.property('fynn:feuer') * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "stand": "(1.0 - query.property('fynn:fliegt')) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt'))) * (1.0 - (query.property('fynn:wartet') * (1.0 - query.has_rider)))"
          },
          {
            "gehen": "(1.0 - query.property('fynn:fliegt')) * math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt'))) * (1.0 - (query.property('fynn:wartet') * (1.0 - query.has_rider)))"
          },
          {
            "platz": "(1.0 - query.property('fynn:fliegt')) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt'))) * (query.property('fynn:wartet') * (1.0 - query.has_rider))"
          },
          {
            "schlafen": "query.property('fynn:schlaeft') * (1.0 - query.property('fynn:besiegt'))"
          },
          {
            "niederliegen": "query.property('fynn:besiegt')"
          },
          {
            "luftholen": "variable.fynn_holen"
          },
          {
            "schattenatem": "variable.fynn_speit"
          },
          {
            "drachenbruellen": "variable.fynn_bruell"
          },
          {
            "sturzflug": "query.property('fynn:fliegt') * math.clamp(-query.vertical_speed * 0.6 - 0.2, 0.0, 1.0)"
          },
          {
            "drachenblick": "(1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "drachenbiss": "(variable.attack_time > 0.0) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "uralt": "query.property('fynn:uralt')"
          }
        ],
        "scale": "1.0"
      },
      "render_controllers": [
        "controller.render.fynn.nachtschwinge"
      ],
      "spawn_egg": {
        "texture": "nachtschwinge_ei",
        "texture_index": 0
      }
    }
  }
}
