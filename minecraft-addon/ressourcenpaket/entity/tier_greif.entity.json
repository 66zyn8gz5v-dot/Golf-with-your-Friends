{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:greif",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "gold": "textures/entity/tiere/greif_gold",
        "weiss": "textures/entity/tiere/greif_weiss",
        "schwarz": "textures/entity/tiere/greif_schwarz"
      },
      "geometry": {
        "default": "geometry.fynn.greif"
      },
      "animations": {
        "laufen": "animation.fynn.greif.laufen",
        "galopp": "animation.fynn.greif.galopp",
        "stehen": "animation.fynn.greif.stehen",
        "blick": "animation.common.look_at_target",
        "kopfschuetteln": "animation.fynn.greif.kopfschuetteln",
        "schwanzschlag": "animation.fynn.greif.schwanzschlag",
        "schnuppern": "animation.fynn.greif.schnuppern",
        "drehen": "animation.fynn.greif.drehen",
        "angriff": "animation.fynn.greif.angriff",
        "schwingen_angelegt": "animation.fynn.greif.schwingen_angelegt",
        "greifenflug": "animation.fynn.greif.greifenflug"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);",
          "variable.galopp = math.clamp((query.modified_move_speed - 0.95) * 4.0, 0.0, 1.0);"
        ],
        "animate": [
          {
            "laufen": "math.clamp(query.modified_move_speed * 1.4, 0.0, 1.0) * (1.0 - variable.galopp)"
          },
          {
            "galopp": "variable.galopp"
          },
          {
            "stehen": "1.0 - math.clamp(query.modified_move_speed * 2.0, 0.0, 0.8)"
          },
          "blick",
          "drehen",
          {
            "kopfschuetteln": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * math.clamp((math.sin(query.life_time * 19.0 + variable.fynn_zufall + 0) - 0.93) * 21.43, 0.0, 1.0)"
          },
          {
            "schwanzschlag": "math.clamp((math.sin(query.life_time * 31.0 + variable.fynn_zufall + 120) - 0.8) * 7.5, 0.0, 1.0)"
          },
          {
            "schnuppern": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * math.clamp((math.sin(query.life_time * 7.0 + variable.fynn_zufall + 40) - 0.88) * 12.5, 0.0, 1.0)"
          },
          {
            "schwingen_angelegt": "1.0 - query.property('fynn:fliegt')"
          },
          {
            "greifenflug": "query.property('fynn:fliegt')"
          },
          {
            "angriff": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.greif"
      ],
      "spawn_egg": {
        "texture": "greif_ei",
        "texture_index": 0
      }
    }
  }
}
