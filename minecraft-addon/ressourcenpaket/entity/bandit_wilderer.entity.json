{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:wilderer",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/banditen/wilderer"
      },
      "geometry": {
        "default": "geometry.fynn.wilderer"
      },
      "animations": {
        "laufen": "animation.fynn.wilderer.laufen",
        "stehen": "animation.fynn.wilderer.stehen",
        "halten": "animation.fynn.wilderer.halten",
        "hieb": "animation.fynn.wilderer.hieb",
        "bogen": "animation.fynn.wilderer.bogen",
        "blick": "animation.common.look_at_target"
      },
      "scripts": {
        "animate": [
          {
            "laufen": "math.clamp(query.modified_move_speed * 1.4, 0.0, 1.0)"
          },
          "stehen",
          "blick",
          "halten",
          {
            "hieb": "variable.attack_time > 0.0"
          },
          {
            "bogen": "query.has_target"
          }
        ],
        "variables": {
          "variable.attack_time": "public",
          "variable.fynn_schwert": "public",
          "variable.fynn_waffe": "public",
          "variable.fynn_schlag": "public",
          "variable.fynn_hiebzeit": "public"
        },
        "initialize": [
          "variable.fynn_schwert = 0.0;",
          "variable.fynn_waffe = 0.0;",
          "variable.fynn_schlag = 0.0;",
          "variable.fynn_hiebzeit = 0.0;"
        ]
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "spawn_egg": {
        "texture": "wilderer_ei",
        "texture_index": 0
      }
    }
  }
}
