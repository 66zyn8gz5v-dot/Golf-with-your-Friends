{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:krokodil",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "alt": "textures/entity/tiere/krokodil_alt",
        "jung": "textures/entity/tiere/krokodil_jung"
      },
      "geometry": {
        "default": "geometry.fynn.krokodil"
      },
      "animations": {
        "laufen": "animation.fynn.krokodil.laufen",
        "stehen": "animation.fynn.krokodil.stehen",
        "blick": "animation.common.look_at_target",
        "kopfschuetteln": "animation.fynn.krokodil.kopfschuetteln",
        "sonnen": "animation.fynn.krokodil.sonnen",
        "drehen": "animation.fynn.krokodil.drehen",
        "schwimmen": "animation.fynn.krokodil.schwimmen",
        "angriff": "animation.fynn.krokodil.angriff",
        "jung": "animation.fynn.krokodil.jung"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);"
        ],
        "animate": [
          {
            "laufen": "!query.is_in_water ? math.clamp(query.modified_move_speed * 1.4, 0.0, 1.0) : 0.0"
          },
          {
            "schwimmen": "query.is_in_water"
          },
          {
            "stehen": "1.0 - math.clamp(query.modified_move_speed * 2.0, 0.0, 0.8)"
          },
          "blick",
          "drehen",
          {
            "kopfschuetteln": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * math.clamp((math.sin(query.life_time * 19.0 + variable.fynn_zufall + 0) - 0.93) * 21.43, 0.0, 1.0)"
          },
          {
            "sonnen": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * (1.0 - query.is_in_water) * math.clamp((math.sin(query.life_time * 9.0 + variable.fynn_zufall + 0) - 0.5) * 3.0, 0.0, 1.0)"
          },
          {
            "angriff": "variable.attack_time > 0.0"
          },
          {
            "jung": "query.is_baby"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.krokodil"
      ],
      "spawn_egg": {
        "base_color": "#3e4a22",
        "overlay_color": "#d8cf9c"
      }
    }
  }
}
