{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:werwolf",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "grau": "textures/entity/tiere/werwolf_grau",
        "schwarz": "textures/entity/tiere/werwolf_schwarz"
      },
      "geometry": {
        "default": "geometry.fynn.werwolf"
      },
      "animations": {
        "als_mensch": "animation.fynn.werwolf.als_mensch",
        "als_wolf": "animation.fynn.werwolf.als_wolf",
        "mensch_geht": "animation.fynn.werwolf.mensch_geht",
        "wolf_geht": "animation.fynn.werwolf.wolf_geht",
        "wolf_steht": "animation.fynn.werwolf.wolf_steht",
        "heulen": "animation.fynn.werwolf.heulen",
        "verwandlung": "animation.fynn.werwolf.verwandlung",
        "pranke": "animation.fynn.werwolf.pranke"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);"
        ],
        "animate": [
          {
            "als_mensch": "1.0 - query.property('fynn:wolf')"
          },
          {
            "als_wolf": "query.property('fynn:wolf')"
          },
          {
            "mensch_geht": "(1.0 - query.property('fynn:wolf')) * math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0)"
          },
          {
            "wolf_geht": "query.property('fynn:wolf') * math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0)"
          },
          {
            "wolf_steht": "query.property('fynn:wolf') * (1.0 - math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0))"
          },
          {
            "heulen": "query.property('fynn:wolf') * (1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * math.clamp((math.sin(query.life_time * 10.0 + variable.fynn_zufall + 30) - 0.9) * 15.0, 0.0, 1.0)"
          },
          {
            "verwandlung": "query.property('fynn:wandelt')"
          },
          {
            "pranke": "query.property('fynn:wolf') * (variable.attack_time > 0.0)"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.werwolf"
      ],
      "spawn_egg": {
        "texture": "werwolf_ei",
        "texture_index": 0
      }
    }
  }
}
