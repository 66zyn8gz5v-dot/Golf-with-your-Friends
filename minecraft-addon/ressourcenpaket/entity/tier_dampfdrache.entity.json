        "misch_frostwyvern": "textures/entity/tiere/dampfdrache_misch_frostwyvern",
        "misch_himmelsdrache": "textures/entity/tiere/dampfdrache_misch_himmelsdrache",
        "misch_giftdrache": "textures/entity/tiere/dampfdrache_misch_giftdrache",
        "misch_nachtschwinge": "textures/entity/tiere/dampfdrache_misch_nachtschwinge",
        "misch_schlunddrache": "textures/entity/tiere/dampfdrache_misch_schlunddrache",
        "misch_dampfdrache": "textures/entity/tiere/dampfdrache_misch_dampfdrache",
        "misch_sternendrache": "textures/entity/tiere/dampfdrache_misch_sternendrache",
        "misch_lavadrache": "textures/entity/tiere/dampfdrache_misch_lavadrache"
      },
      "geometry": {
