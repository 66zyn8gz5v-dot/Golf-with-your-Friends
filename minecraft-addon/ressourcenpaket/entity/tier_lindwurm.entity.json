{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:lindwurm",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "gruen": "textures/entity/tiere/lindwurm_gruen",
        "rot": "textures/entity/tiere/lindwurm_rot",
        "schwarz": "textures/entity/tiere/lindwurm_schwarz"
      },
      "geometry": {
        "default": "geometry.fynn.lindwurm"
      },
      "animations": {
        "flug": "animation.fynn.lindwurm.flug",
        "stand": "animation.fynn.lindwurm.stand",
        "feueratem": "animation.fynn.lindwurm.feueratem",
        "sturzflug": "animation.fynn.lindwurm.sturzflug"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);"
        ],
        "animate": [
          {
            "flug": "1.0 - query.is_on_ground"
          },
          {
            "stand": "query.is_on_ground"
          },
          {
            "feueratem": "query.property('fynn:feuer')"
          },
          {
            "sturzflug": "math.clamp(-query.vertical_speed * 0.6 - 0.2, 0.0, 1.0)"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.lindwurm"
      ],
      "spawn_egg": {
        "texture": "lindwurm_ei",
        "texture_index": 0
      }
    }
  }
}
