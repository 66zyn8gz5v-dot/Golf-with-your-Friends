{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:eichhoernchen",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "rot": "textures/entity/tiere/eichhoernchen_rot",
        "grau": "textures/entity/tiere/eichhoernchen_grau"
      },
      "geometry": {
        "default": "geometry.fynn.eichhoernchen"
      },
      "animations": {
        "laufen": "animation.fynn.eichhoernchen.laufen",
        "galopp": "animation.fynn.eichhoernchen.galopp",
        "stehen": "animation.fynn.eichhoernchen.stehen",
        "blick": "animation.common.look_at_target",
        "kopfschuetteln": "animation.fynn.eichhoernchen.kopfschuetteln",
        "schwanzschlag": "animation.fynn.eichhoernchen.schwanzschlag",
        "schnuppern": "animation.fynn.eichhoernchen.schnuppern",
        "drehen": "animation.fynn.eichhoernchen.drehen",
        "schwanzzucken": "animation.fynn.eichhoernchen.schwanzzucken",
        "klettern": "animation.fynn.eichhoernchen.klettern",
        "graben": "animation.fynn.eichhoernchen.graben",
        "knabbern": "animation.fynn.eichhoernchen.knabbern"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);",
          "variable.galopp = math.clamp((query.modified_move_speed - 0.95) * 4.0, 0.0, 1.0);"
        ],
        "animate": [
          {
            "laufen": "math.clamp(query.modified_move_speed * 1.4, 0.0, 1.0) * (1.0 - variable.galopp)"
          },
          {
            "galopp": "variable.galopp"
          },
          {
            "stehen": "1.0 - math.clamp(query.modified_move_speed * 2.0, 0.0, 0.8)"
          },
          "blick",
          "drehen",
          {
            "kopfschuetteln": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * math.clamp((math.sin(query.life_time * 19.0 + variable.fynn_zufall + 0) - 0.93) * 21.43, 0.0, 1.0)"
          },
          {
            "schwanzschlag": "math.clamp((math.sin(query.life_time * 31.0 + variable.fynn_zufall + 120) - 0.8) * 7.5, 0.0, 1.0)"
          },
          {
            "schnuppern": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * math.clamp((math.sin(query.life_time * 7.0 + variable.fynn_zufall + 40) - 0.88) * 12.5, 0.0, 1.0)"
          },
          {
            "schwanzzucken": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * math.clamp((math.sin(query.life_time * 16.0 + variable.fynn_zufall + 60) - 0.75) * 6.0, 0.0, 1.0)"
          },
          {
            "klettern": "query.property('fynn:klettert')"
          },
          {
            "graben": "query.property('fynn:graebt')"
          },
          {
            "knabbern": "(1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0)) * query.is_on_ground * math.clamp((math.sin(query.life_time * 12.0 + variable.fynn_zufall + 150) - 0.7) * 5.0, 0.0, 1.0) * (1.0 - query.property('fynn:klettert')) * (1.0 - query.property('fynn:graebt'))"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.eichhoernchen"
      ],
      "spawn_egg": {
        "texture": "eichhoernchen_ei",
        "texture_index": 0
      }
    }
  }
}
