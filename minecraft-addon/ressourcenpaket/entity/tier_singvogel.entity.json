{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:singvogel",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "rotkehlchen": "textures/entity/tiere/singvogel_rotkehlchen",
        "blaumeise": "textures/entity/tiere/singvogel_blaumeise",
        "spatz": "textures/entity/tiere/singvogel_spatz"
      },
      "geometry": {
        "default": "geometry.fynn.singvogel"
      },
      "animations": {
        "flattern": "animation.fynn.singvogel.flattern",
        "hopsen": "animation.fynn.singvogel.hopsen",
        "am_boden": "animation.fynn.singvogel.am_boden",
        "alarm": "animation.fynn.singvogel.alarm",
        "sitzen": "animation.fynn.singvogel.sitzen"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);"
        ],
        "animate": [
          {
            "flattern": "1.0 - query.is_on_ground"
          },
          {
            "hopsen": "query.is_on_ground * math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0)"
          },
          {
            "am_boden": "query.is_on_ground * (1.0 - math.clamp(query.modified_move_speed * 3.0, 0.0, 1.0))"
          },
          {
            "alarm": "query.property('fynn:warnt')"
          },
          {
            "sitzen": "query.is_sitting"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.singvogel"
      ],
      "spawn_egg": {
        "texture": "singvogel_ei",
        "texture_index": 0
      }
    }
  }
}
