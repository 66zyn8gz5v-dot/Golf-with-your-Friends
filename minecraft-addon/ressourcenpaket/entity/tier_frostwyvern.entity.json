{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:frostwyvern",
      "materials": {
        "default": "entity_emissive_alpha"
      },
      "textures": {
        "eis": "textures/entity/tiere/frostwyvern_eis",
        "gletscher": "textures/entity/tiere/frostwyvern_gletscher",
        "nacht": "textures/entity/tiere/frostwyvern_nacht"
      },
      "geometry": {
        "default": "geometry.fynn.frostwyvern"
      },
      "animations": {
        "flug": "animation.fynn.frostwyvern.flug",
        "schweben": "animation.fynn.frostwyvern.schweben",
        "stand": "animation.fynn.frostwyvern.stand",
        "gehen": "animation.fynn.frostwyvern.gehen",
        "liegen": "animation.fynn.frostwyvern.liegen",
        "benommen": "animation.fynn.frostwyvern.benommen",
        "feueratem": "animation.fynn.frostwyvern.feueratem",
        "drachenbruellen": "animation.fynn.frostwyvern.drachenbruellen",
        "sturzflug": "animation.fynn.frostwyvern.sturzflug",
        "drachenblick": "animation.fynn.frostwyvern.drachenblick",
        "drachenbiss": "animation.fynn.frostwyvern.drachenbiss"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);",
          "variable.fynn_t = query.life_time + variable.fynn_zufall * 0.05;",
          "variable.fynn_ruhig = (1.0 - math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0)) * (1.0 - query.property('fynn:feuer')) * (1.0 - query.property('fynn:fliegt')) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')));",
          "variable.fynn_bz = math.mod(variable.fynn_t, 17.0);",
          "variable.fynn_bruell = variable.fynn_bz < 2.4 ? math.clamp(math.sin(variable.fynn_bz / 2.4 * 180.0) * 2.2, 0.0, 1.0) * variable.fynn_ruhig : 0.0;",
          "variable.fynn_sz = math.mod(variable.fynn_t + 6.0, 31.0);",
          "variable.fynn_offen_l = math.max(variable.fynn_bruell, math.clamp(math.sin(math.clamp((variable.fynn_sz - 0.0) / 3.2, 0.0, 1.0) * 180.0) * 1.6, 0.0, 1.0) * variable.fynn_ruhig);",
          "variable.fynn_offen_r = math.max(variable.fynn_bruell, math.clamp(math.sin(math.clamp((variable.fynn_sz - 3.8) / 3.2, 0.0, 1.0) * 180.0) * 1.6, 0.0, 1.0) * variable.fynn_ruhig);"
        ],
        "animate": [
          {
            "flug": "query.property('fynn:fliegt') * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "schweben": "query.property('fynn:fliegt') * query.property('fynn:feuer') * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "stand": "(1.0 - query.property('fynn:fliegt')) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "gehen": "(1.0 - query.property('fynn:fliegt')) * math.clamp(query.modified_move_speed * 4.0, 0.0, 1.0) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "liegen": "math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt'))"
          },
          {
            "benommen": "query.property('fynn:besiegt')"
          },
          {
            "feueratem": "query.property('fynn:feuer')"
          },
          {
            "drachenbruellen": "variable.fynn_bruell"
          },
          {
            "sturzflug": "query.property('fynn:fliegt') * math.clamp(-query.vertical_speed * 0.6 - 0.2, 0.0, 1.0)"
          },
          {
            "drachenblick": "(1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          },
          {
            "drachenbiss": "(variable.attack_time > 0.0) * (1.0 - math.max(query.property('fynn:schlaeft'), query.property('fynn:besiegt')))"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.frostwyvern"
      ],
      "spawn_egg": {
        "texture": "frostwyvern_ei",
        "texture_index": 0
      }
    }
  }
}
