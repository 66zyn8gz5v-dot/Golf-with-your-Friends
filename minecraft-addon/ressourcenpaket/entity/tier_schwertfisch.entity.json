{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "fynn:schwertfisch",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "blau": "textures/entity/tiere/schwertfisch_blau"
      },
      "geometry": {
        "default": "geometry.fynn.schwertfisch"
      },
      "animations": {
        "schwimmen": "animation.fynn.schwertfisch.schwimmen",
        "an_land": "animation.fynn.schwertfisch.an_land",
        "angriff": "animation.fynn.schwertfisch.angriff"
      },
      "scripts": {
        "initialize": [
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = 0.0;",
          "variable.fynn_zufall = math.random(0.0, 360.0);"
        ],
        "pre_animation": [
          "variable.fynn_d = query.body_y_rotation - variable.fynn_gier_alt;",
          "variable.fynn_d = variable.fynn_d > 180.0 ? variable.fynn_d - 360.0 : (variable.fynn_d < -180.0 ? variable.fynn_d + 360.0 : variable.fynn_d);",
          "variable.fynn_gier_alt = query.body_y_rotation;",
          "variable.fynn_dreh = math.lerp(variable.fynn_dreh, math.clamp(variable.fynn_d / math.max(query.delta_time, 0.01) / 20.0, -10.0, 10.0), 0.12);"
        ],
        "animate": [
          {
            "schwimmen": "query.is_in_water"
          },
          {
            "an_land": "!query.is_in_water"
          },
          {
            "angriff": "variable.attack_time > 0.0"
          }
        ]
      },
      "render_controllers": [
        "controller.render.fynn.schwertfisch"
      ],
      "spawn_egg": {
        "texture": "schwertfisch_ei",
        "texture_index": 0
      }
    }
  }
}
