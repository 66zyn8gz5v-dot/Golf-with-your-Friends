{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.fynn.elch": {
      "arrays": {
        "textures": {
          "Array.haut": [
            "Texture.bulle",
            "Texture.kuh"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Texture.kalb : Array.haut[query.variant]"
      ],
      "part_visibility": [
        {
          "sattel": "query.is_saddled"
        },
        {
          "tasche_links": "query.property('fynn:taschen') >= 1"
        },
        {
          "tasche_rechts": "query.property('fynn:taschen') >= 2"
        }
      ]
    }
  }
}
