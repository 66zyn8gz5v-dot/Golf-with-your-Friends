{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.fynn.lindwurm": {
      "arrays": {
        "textures": {
          "Array.haut": [
            "Texture.gruen",
            "Texture.rot",
            "Texture.schwarz"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.haut[query.variant]"
      ],
      "part_visibility": [
        {
          "lider": "query.property('fynn:schlaeft') || query.property('fynn:besiegt') || math.mod(variable.fynn_t + 0.0, 4.7) < 0.14"
        },
        {
          "sattel": "query.is_saddled"
        }
      ]
    }
  }
}
