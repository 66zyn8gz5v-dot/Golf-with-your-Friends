{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.fynn.giftdrache": {
      "arrays": {
        "textures": {
          "Array.haut": [
            "Texture.sumpf",
            "Texture.moor",
            "Texture.gift"
          ]
        }
      },
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Array.haut[query.variant]"
      ],
      "part_visibility": [
        {
          "lider_a": "query.property('fynn:schlaeft') || query.property('fynn:besiegt') || math.mod(variable.fynn_t + 0.0, 4.7) < 0.14"
        },
        {
          "lider_b": "query.property('fynn:schlaeft') || query.property('fynn:besiegt') || math.mod(variable.fynn_t + 0.9, 4.7) < 0.14"
        },
        {
          "sattel": "query.is_saddled"
        }
      ]
    }
  }
}
